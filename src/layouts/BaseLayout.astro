---
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

const { title = "Blake's Portfolio" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title> {title} </title>
  </head>

  <body>
    <Navbar />
    <slot />
    <Footer/>
  </body>
</html>