---
import { Image } from 'astro:assets';
import peterPhoto from '../assets/peter.jpeg';
---



<section class="about">
  <div class="about-image">
     <Image src={peterPhoto} alt="Photo of Blake" />
  </div>

  <div class="about-content">
    <h2>☕ About Me</h2>

    <p>
      I am a <strong>Computer Science</strong> graduate, currently
      building my skills in <strong>networking</strong>,
      <strong>systems administration</strong>, and
      <strong> infrastructure</strong>. I hold my
      <strong> CompTIA Network+ </strong> and <strong>Security+ </strong>
      certifications. 
    </p>
    <p>
      My technical curiosity has led me to build a homelab, work on
      various IT projects, and actively learn through hands-on
      troubleshooting and self-hosted infrastructure.
    </p>

    <h3>Experience</h3>

    <div class="experience-list">
      <div class="experience-item">
        <div class="experience-info">
          <h4>League of legends gamer</h4>
          <p class="company">riot games</p>
        </div>
        <span class="date-badge">Oct 2 2001 - The end of time</span>
      </div>

      <div class="experience-item">
        <div class="experience-info">
          <h4>Bloons Destroyer</h4>
          <p class="company">NinjaKiwi</p>
        </div>
        <span class="date-badge">Erry day</span>
      </div>

      <div class="experience-item">
        <div class="experience-info">
          <h4>Homeless</h4>
          <p class="company"> Cardboard Box</p>
        </div>
        <span class="date-badge">Feb 2020 - Jan 2022</span>
      </div>

      

    </div>
  </div>
</section>

<style>
  .about {
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: 3rem;
    padding: 4rem 2rem;
    max-width: 1200px;
    margin: 0 auto;
    font-family: system-ui, -apple-system, sans-serif;
    color: #cccccc;
  }


  .about-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 1rem;
    filter: grayscale(100%);
  }

  .about-content h2 {
    font-size: 1.75rem;
    font-weight: 700;
    color: #a49e9e;
    margin-bottom: 1.5rem;
  }

  .about-content p {
    font-size: 1rem;
    line-height: 1.7;
    color: #999999;
    margin-bottom: 1rem;
  }

  .about-content p strong {
   .about-content p strong {
  color: #ffffff;
  font-weight: 700;
}
  }

  .about-content h3 {
    font-size: 1.4rem;
    font-weight: 700;
    color: #ffffff;
    margin: 2rem 0 1rem 0;
  }

  .experience-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .experience-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: #111111;
    border: 1px solid #222222;
    border-radius: 0.75rem;
    padding: 1.25rem 1.5rem;
  }

  .experience-info h4 {
    font-size: 1.05rem;
    font-weight: 700;
    color: #ffffff;
    margin: 0 0 0.25rem 0;
  }

  .experience-info .company {
    font-size: 0.9rem;
    color: #888888;
    margin: 0;
  }

  .date-badge {
    font-family: 'Courier New', monospace;
    font-size: 0.8rem;
    color: #999999;
    background: #1a1a1a;
    border: 1px solid #2a2a2a;
    border-radius: 0.5rem;
    padding: 0.5rem 0.75rem;
    white-space: nowrap;
  }

  @media (max-width: 768px) {
    .about {
      grid-template-columns: 1fr;
    }

    .experience-item {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
    }
  }
</style>