<section class="contact" id="contact">
  <div class="contact-content">
    <h2>Let's work together.</h2>
    <p>Have a project in mind? Let's build something amazing together.</p>

    <div class="cta-group">
      <a href="mailto:your-email@example.com" class="btn-primary">
        Send an email
      </a>
      <button class="btn-secondary" id="copy-email-contact">
        Copy email address
      </button>
    </div>

    <span class="copy-feedback" id="copy-feedback">Copied!</span>
  </div>
</section>

<style>
  .contact {
    padding: 2rem 2rem;
    max-width: 1200px;
    margin: 0 auto;
    font-family: system-ui, -apple-system, sans-serif;
  }

  .contact-content {
    background: #111111;
    border: 1px solid #2a2a2a;
    border-radius: 1.5rem;
    padding: 4rem 2rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .contact-content h2 {
    font-size: 3rem;
    font-weight: 800;
    color: #ffffff;
    margin: 0 0 1rem 0;
  }

  .contact-content p {
    font-size: 1.1rem;
    color: #999999;
    max-width: 500px;
    margin-bottom: 2.5rem;
  }

  .cta-group {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    background: #ffffff;
    color: #111111;
    text-decoration: none;
    padding: 0.9rem 1.75rem;
    border-radius: 999px;
    font-weight: 600;
    font-size: 0.95rem;
  }

  .btn-secondary {
    display: inline-flex;
    align-items: center;
    background: transparent;
    color: #ffffff;
    border: 1px solid #333333;
    padding: 0.9rem 1.75rem;
    border-radius: 999px;
    font-weight: 600;
    font-size: 0.95rem;
    cursor: pointer;
    font-family: inherit;
  }

  .copy-feedback {
    margin-top: 1rem;
    font-size: 0.85rem;
    color: #00ff00;
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .copy-feedback.show {
    opacity: 1;
  }

  @media (max-width: 768px) {
    .contact-content h2 {
      font-size: 2rem;
    }
  }
</style>

<script>
  const copyBtn = document.getElementById('copy-email-contact');
  const feedback = document.getElementById('copy-feedback');

  copyBtn?.addEventListener('click', () => {
    navigator.clipboard.writeText('your-email@example.com');
    feedback?.classList.add('show');
    setTimeout(() => feedback?.classList.remove('show'), 2000);
  });
</script>