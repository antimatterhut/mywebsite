<div class="navbar-wrapper">
  <nav class="navbar">
    <button class="hamburger" id="hamburger" aria-label="Toggle menu">
      <span></span>
      <span></span>
      <span></span>
    </button>

    <ul class="nav-links" id="nav-links">
      <li><a href="#home">Home</a></li>
      <li><a href="#about">About</a></li>
      <li><a href="#projects">Projects</a></li>
      <li><a href="#homelab">Homelab</a></li>
      <li><a href="#contact">Contact</a></li>
    </ul>

    <div class="status">
      <span class="pulse-dot"></span>
      <span>Good Afternoon</span>
    </div>

    <button class="theme-toggle" aria-label="Toggle theme">☀️</button>
  </nav>
</div>

<style>
  .navbar-wrapper {
    display: flex;
    justify-content: center;
    padding: 1.5rem 2rem 0 2rem;
  }

  .navbar {
    background: #111111;
    border: 1px solid #2a2a2a;
    border-radius: 2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.75rem 1.5rem;
    font-family: system-ui, -apple-system, sans-serif;
    width: 100%;
    max-width: 700px;
    position: relative;
  }

  /* ...everything below this is unchanged... */

  .nav-links {
    display: flex;
    gap: 1.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-links a {
    text-decoration: none;
    color: #cccccc;
    font-size: 0.95rem;
  }

  .nav-links a:hover {
    color: #ffffff;
  }

  .status {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: #999999;
    font-size: 0.9rem;
    padding-left: 1.5rem;
    margin-left: 1.5rem;
    border-left: 1px solid #333333;
  }

  .theme-toggle {
    background: none;
    border: none;
    cursor: pointer;
    font-size: 1.1rem;
    margin-left: 1.5rem;
    color: #cccccc;
  }

  .pulse-dot {
    width: 8px;
    height: 8px;
    background: #00ff00;
    border-radius: 100%;
    animation: pulse 1.5s infinite;
  }

  @keyframes pulse {
    0% { box-shadow: 0 0 0 0 rgba(0, 255, 0, 0.7); }
    70% { box-shadow: 0 0 0 6px rgba(0, 255, 0, 0); }
    100% { box-shadow: 0 0 0 0 rgba(0, 255, 0, 0); }
  }

  .hamburger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 4px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.25rem;
  }

  .hamburger span {
    width: 20px;
    height: 2px;
    background: #cccccc;
    border-radius: 2px;
  }

  @media (max-width: 768px) {
    .navbar {
      border-radius: 1rem;
      padding: 0.75rem 1rem;
    }

    .navbar-wrapper {
      padding: 1rem 1rem 0 1rem;
    }

    .hamburger {
      display: flex;
    }

    .nav-links {
      display: none;
      flex-direction: column;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      margin-top: 0.5rem;
      background: #111111;
      border: 1px solid #2a2a2a;
      border-radius: 1rem;
      padding: 1rem;
      gap: 1rem;
    }

    .nav-links.open {
      display: flex;
    }

    .status span:last-child {
      display: none;
    }
  }
</style>

<script>
  const hamburger = document.getElementById('hamburger');
  const navLinks = document.getElementById('nav-links');

  hamburger?.addEventListener('click', () => {
    navLinks?.classList.toggle('open');
  });
</script>